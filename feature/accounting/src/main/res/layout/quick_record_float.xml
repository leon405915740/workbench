<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/quick_card_bg"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="快捷记账"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/quick_card_text_primary" />

        <ImageButton
            android:id="@+id/btn_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@null"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="关闭" />
    </LinearLayout>

    <EditText
        android:id="@+id/et_amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="金额"
        android:inputType="numberDecimal"
        android:textSize="16sp"
        android:background="@drawable/quick_edit_bg"
        android:paddingHorizontal="12dp"
        android:paddingVertical="12dp"
        android:textColor="@color/quick_card_text_primary"
        android:textColorHint="@color/quick_card_text_secondary"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="分类"
        android:textSize="13sp"
        android:textColor="@color/quick_card_text_secondary"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tv_category"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingVertical="12dp"
        android:textSize="14sp"
        android:background="@drawable/quick_edit_bg"
        android:textColor="@color/quick_card_text_primary"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:id="@+id/category_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/et_merchant"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="商家（选填）"
        android:textSize="14sp"
        android:background="@drawable/quick_edit_bg"
        android:paddingHorizontal="12dp"
        android:paddingVertical="12dp"
        android:textColor="@color/quick_card_text_primary"
        android:textColorHint="@color/quick_card_text_secondary"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/et_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="备注（选填）"
        android:textSize="14sp"
        android:background="@drawable/quick_edit_bg"
        android:paddingHorizontal="12dp"
        android:paddingVertical="12dp"
        android:textColor="@color/quick_card_text_primary"
        android:textColorHint="@color/quick_card_text_secondary"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="取消"
            android:textSize="16sp"
            android:backgroundTint="@color/quick_card_gray"
            android:textColor="@color/quick_card_text_primary" />

        <Button
            android:id="@+id/btn_submit"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="确认"
            android:textSize="16sp"
            android:textColor="#FFFFFFFF"
            android:backgroundTint="@color/quick_card_green" />
    </LinearLayout>
</LinearLayout>


